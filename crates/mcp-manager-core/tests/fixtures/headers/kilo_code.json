{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "mcp": {
    "remote": {
      "type": "remote",
      "url": "https://mcp.example.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer fixture-token",
        "X-Api-Key": "fixture-key"
      }
    },
    "other": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    }
  }
}
