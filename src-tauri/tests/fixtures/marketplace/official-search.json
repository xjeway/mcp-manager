                "name": "DOCKER_MCP_PROFILES_FILE"
              },
              {
                "description": "The same profiles JSON inline, used when no profiles file is set.",
                "format": "string",
                "name": "DOCKER_PROFILES"
              },
              {
                "description": "Keep going when a profile's SSH key is missing, instead of refusing the profile. Defaults to false.",
                "format": "boolean",
                "name": "DOCKER_MCP_ALLOW_SSH_FALLBACK"
              },
              {
                "description": "Log verbosity: error, warn, info or debug. Defaults to info.",
                "format": "string",
                "name": "LOG_LEVEL"
              }
            ]
          }
        ]
